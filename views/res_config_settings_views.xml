<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.advance.payment.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="inside">
                    <setting>
                        <field name="has_accounting_advance_payments"/>
                    </setting>
                    <setting id="account_advance_payments" string="Cuentas de anticipos:" invisible="not has_accounting_advance_payments">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="account_receivable_advance_id" class="col-lg-5 o_light_label"/>
                                <field name="account_receivable_advance_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="account_payable_advance_id" class="col-lg-5 o_light_label"/>
                                <field name="account_payable_advance_id"/>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
